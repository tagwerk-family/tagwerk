{
    "name": "fahoba/mcp",
    "description": "Lets an AI assistant read and change a household through the Model Context Protocol, with an API token",
    "type": "library",
    "version": "0.1.0",
    "license": "PolyForm-Shield-1.0.0",
    "require": {
        "php": "^8.5",
        "laravel/mcp": "^1.1",
        "fahoba/plugin-api": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Fahoba\\Mcp\\": "src/"
        }
    },
    "extra": {
        "fahoba": {
            "provider": "Fahoba\\Mcp\\McpServiceProvider"
        }
    }
}
