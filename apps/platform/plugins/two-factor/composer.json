{
    "name": "fahoba/two-factor",
    "description": "Two-factor sign-in for Fahoba: authenticator app and recovery codes, switched on by the operator",
    "type": "library",
    "version": "0.1.0",
    "license": "PolyForm-Shield-1.0.0",
    "require": {
        "php": "^8.5",
        "fahoba/plugin-api": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Fahoba\\TwoFactor\\": "src/"
        }
    },
    "extra": {
        "fahoba": {
            "provider": "Fahoba\\TwoFactor\\TwoFactorServiceProvider"
        }
    }
}
