APP_NAME=Fahoba
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://fahoba.test
APP_VERSION=dev

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb tells wall and phone about changes, so they do not wait for the
# next poll. If it is unreachable, only the instant update is lost -- both
# keep polling regularly.
#
# REVERB_HOST/PORT/SCHEME are the browser's view, REVERB_SERVER_* the
# service's inside the container. In development DDEV exposes port 8080 with
# TLS, the service itself listens unencrypted behind it.
REVERB_APP_ID=fahoba
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=fahoba.test
REVERB_PORT=8080
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Calendar — cloud project with the Calendar API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_URL="${APP_URL}/api/calendar/google/webhook"
GOOGLE_WEBHOOK_TOKEN=

# Web push to the phone PWA. Generate once with
# `ddev exec 'cd apps/platform && php artisan fahoba:vapid-keys'`, then keep
# it safe: changing the public key invalidates every existing subscription,
# each browser would have to subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@copex.io
