{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fahoba/platform",
    "type": "project",
    "description": "Fahoba: a family calendar for a wall tablet and the family's phones, several households on one server.",
    "keywords": ["family", "calendar", "wall tablet", "kiosk", "self-hosted"],
    "homepage": "https://github.com/fahoba/fahoba",
    "license": "PolyForm-Shield-1.0.0",
    "require": {
        "php": "^8.5",
        "azuyalabs/yasumi": "^2.11",
        "bacon/bacon-qr-code": "^3.1",
        "filament/filament": "^5.10.1",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.0",
        "minishlink/web-push": "^11.0",
        "rlanvin/php-rrule": "^3.0",
        "fahoba/plugin-api": "^0.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "fahoba/bring": "^0.1",
        "fahoba/caldav": "^0.1",
        "fahoba/example-area": "^0.1",
        "fahoba/example-language": "^0.1",
        "fahoba/example-theme": "^0.1",
        "fahoba/ics-feed": "^0.1",
        "fahoba/kochwiki": "^0.1",
        "fahoba/mcp": "^0.1",
        "fahoba/openapi": "^0.1",
        "fahoba/social-login": "^0.1",
        "fahoba/two-factor": "^0.1",
        "fahoba/webdav-backup": "^0.1",
        "fahoba/webhooks": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "plugins",
        "type": "path",
        "url": "plugins/*",
        "options": {
            "symlink": true
        }
    }, {
        "name": "packages",
        "type": "path",
        "url": "packages/*",
        "options": {
            "symlink": true
        }
    }]
}
