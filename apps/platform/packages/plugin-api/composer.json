{
    "name": "fahoba/plugin-api",
    "description": "Contracts and helpers for Fahoba plugins",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.17",
        "illuminate/database": "^13.17",
        "illuminate/http": "^13.17",
        "nesbot/carbon": "^3.15",
        "filament/filament": "^5.10.1"
    },
    "autoload": {
        "psr-4": {
            "Fahoba\\PluginApi\\": "src/"
        }
    },
    "suggest": {
        "phpunit/phpunit": "for Fahoba\\PluginApi\\Testing, the assertions a plugin's own tests use"
    },
    "homepage": "https://github.com/fahoba/fahoba",
    "support": {
        "issues": "https://github.com/fahoba/fahoba/issues",
        "source": "https://github.com/fahoba/fahoba/tree/master/apps/platform/packages/plugin-api",
        "docs": "https://github.com/fahoba/fahoba/blob/master/docs/plugins.md"
    }
}
