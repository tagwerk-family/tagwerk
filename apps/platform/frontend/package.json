{
  "name": "fahoba-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter app exec nuxi typecheck && pnpm --filter @fahoba/client typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gcqx-w48m-w2h4"
      ]
    },
    "overrides": {
      "source-map-js": "^1.2.2",
      "serialize-javascript": "^7.1.3",
      "vue-i18n": "^11.4.14",
      "@intlify/core": "^11.4.14",
      "@intlify/core-base": "^11.4.14",
      "@intlify/message-compiler": "^11.4.14",
      "@intlify/shared": "^11.4.14",
      "@nuxt/devtools": "-",
      "node-forge": "^1.4.1",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
