<?php

declare(strict_types=1);

namespace {{ namespace }};

use Fahoba\PluginApi\Themes\Theme;

/**
 * A design for Fahoba: colours, font and corners for wall and phone. The
 * stylesheet sets Fahoba's design tokens and nothing else; the test checks
 * it the way Fahoba will.
 */
final class {{ class }}Theme implements Theme
{
    /** What the settings show. */
    public function name(): string
    {
        return '{{ title }}';
    }

    public function stylesheet(): string
    {
        return dirname(__DIR__).'/resources/theme.css';
    }
}
