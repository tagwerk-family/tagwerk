# Production settings. Copy to .env next to compose.yaml and fill in the
# empty values. Keep the file out of any repository: APP_KEY decrypts every
# stored credential, and a lost VAPID key logs out every phone's push.
# Step by step: docs/installation.md

# Which setup: compose.yaml (behind Traefik, built from the source) or
# compose.standalone.yaml (Caddy in front, the published image).
COMPOSE_FILE=compose.standalone.yaml
# Standalone only: a public host name (Caddy fetches the certificate) or
# :80 behind a proxy of your own, then with FAHOBA_HTTP_PORT, e.g. 8080.
FAHOBA_SITE=
FAHOBA_HTTP_PORT=80
FAHOBA_HTTPS_PORT=443
# The image, for both setups; fahoba-app builds it from this checkout.
FAHOBA_IMAGE=ghcr.io/fahoba/fahoba:latest

APP_NAME="Family Home Base"
APP_ENV=production
APP_DEBUG=false
# The public HTTPS address, e.g. https://fahoba.example.org
APP_URL=
# php artisan key:generate --show (run once, e.g. in `docker compose run --rm app`)
APP_KEY=
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
# Wall tablets reload themselves when this changes. Empty: the image's
# build marker (the commit it was built from in CI), which changes with
# every new image. Set it by hand only for local builds, e.g. the commit
# hash. Not the release number in CHANGELOG.md.
APP_VERSION=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fahoba
DB_USERNAME=fahoba
DB_PASSWORD=

# No Valkey: cache, queue and session live in PostgreSQL. For a handful of
# households that costs nothing noticeable and saves a service.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local

# Plugins, installed when the container starts; none by default. Space-
# separated, e.g. "fahoba/caldav fahoba/two-factor fahoba/ics-feed".
# Fahoba's own come from the image at its version; others from Packagist
# (vendor/name or vendor/name:^1.2). A plugin that cannot be installed stops
# the start. List: docs/plugins.md#installing-a-plugin
FAHOBA_PLUGINS=
# Further Composer repositories for plugins not on Packagist (space-separated
# https VCS addresses). A private one needs COMPOSER_AUTH, e.g.
# {"github-oauth":{"github.com":"<token>"}}.
FAHOBA_COMPOSER_REPOSITORIES=
COMPOSER_AUTH=
# A community frontend in place of Fahoba's own app (vendor/name, or with a
# constraint), installed like a plugin. Empty: the official app. One that
# cannot be served stops the start. Guide: docs/frontends.md
FAHOBA_FRONTEND=

# The admin panel only from these networks (IPs or CIDR, comma-
# separated), e.g. your tailnet 100.64.0.0/10. Empty: open to everyone.
FAHOBA_ADMIN_ALLOWED_IPS=

# Content Security Policy: report-only (default) has browsers report what it
# would block to the log ("Content security policy violation"); once the log
# stays quiet for a while, set enforce. off removes the header.
FAHOBA_CSP=report-only
# A known vulnerability in a PHP dependency stops the build (strict). warn only
# reports it — for the day a fix must go out before the dependency's fix.
# The frontend's packages are build tools; the build only reports them.
FAHOBA_AUDIT=strict
# Addresses allowed to set X-Forwarded-For. Empty: the private ranges, which
# covers Traefik on any Docker network. Narrow it only if needed.
FAHOBA_TRUSTED_PROXIES=
# compose.yaml only — Traefik: the host name (matching APP_URL) and, if
# yours differ, network, entrypoint and certificate resolver.
FAHOBA_HOST=
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Host directory with one photo folder per household id. Optional.
FAHOBA_PHOTO_FOLDERS_HOST=./photos

# Realtime: with the "realtime" profile set BROADCAST_CONNECTION=reverb and
# fill in the REVERB_* keys. Without it, wall and phone poll every five
# minutes.
BROADCAST_CONNECTION=null
REVERB_APP_ID=fahoba
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The public host name, as the browser sees it; TLS through the proxy.
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# off: the server sends no mail at all. Accounts get their password from a
# parent or the operator in /admin; no invitations, no password reset, no
# sign-in links. The MAIL_* lines below are then unused. Needs a restart.
FAHOBA_MAIL=on

# Mail over SMTP: password reset, invitations, sign-in links. Sent by the
# queue worker in the app container.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Google (calendar and tasks). Redirect URIs in the Cloud Console:
# ${APP_URL}/auth/calendar/google/callback and ${APP_URL}/auth/tasks/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_URL="${APP_URL}/api/calendar/google/webhook"
GOOGLE_WEBHOOK_TOKEN=

# Sign in with Google (plugin fahoba/social-login; switch it on in /admin
# under Operations → Extensions). Best a Cloud project of its own with only
# openid, email and profile — then it may go to production without Google's
# review. Redirect URI: ${APP_URL}/social/google/callback
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=

# Web push. php artisan fahoba:vapid-keys — once, then keep safe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@copex.io
